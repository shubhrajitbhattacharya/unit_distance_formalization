import PlanarUnitDistances.GenericParameters

namespace PlanarUnitDistances.GenericParameters
open Set
noncomputable section

/-- The differential equation on the complete grid in the manuscript. -/
def Compatible {I K : Type*} [Field K] (p : I → Fin 2 → K) (r : Fin 4 → Fin 2 → K)
    (R : I → Fin 4 → K) (H : I → Fin 2 → K) (U : Fin 4 → Fin 2 → K)
    (A : I → K) (a : Fin 4 → K) : Prop :=
  ∀ i j, 2*((p i 0-r j 0)*(H i 0-U j 0)+(p i 1-r j 1)*(H i 1-U j 1)) =
      R i j*(A i-a j) ∧ A i ≠ a j

/-- Translation, rotation and a scalar translation preserve the equations,
and set the first three anchor entries and one second-anchor velocity to zero. -/
theorem remove_rigid_motion {I K : Type*} [Field K] {p : I → Fin 2 → K}
    {r : Fin 4 → Fin 2 → K} {R H U A a} (eqs : Compatible p r R H U A a)
    (hr : r 1 ≠ r 0) :
    ∃ H' U' A' a', ∃ k : Fin 2, Compatible p r R H' U' A' a' ∧
      (∀ h, U' 0 h = 0) ∧ a' 0 = 0 ∧ U' 1 k = 0 := by
  classical
  let J (v : Fin 2 → K) (k : Fin 2) : K := ![-(v 1-r 0 1), v 0-r 0 0] k
  have nonzero : ∃ k, J (r 1) k ≠ 0 := by
    by_contra! h
    apply hr
    funext k
    have h0 := h 0
    have h1 := h 1
    simp [J] at h0 h1
    fin_cases k
    · exact sub_eq_zero.mp h1
    · exact (sub_eq_zero.mp h0).symm
  obtain ⟨k,hk⟩ := nonzero
  let w := (U 1 k-U 0 k)/J (r 1) k
  let V (x u : Fin 2 → K) (c : Fin 2) := u c - U 0 c - w*J x c
  refine ⟨fun i => V (p i) (H i), fun j => V (r j) (U j),
    fun i => A i-a 0, fun j => a j-a 0, k, ?_, ?_, sub_self _, ?_⟩
  · intro i j
    obtain ⟨he,hn⟩ := eqs i j
    constructor
    · dsimp [V,J]
      linear_combination he
    · simpa using hn
  · intro h
    fin_cases h <;> simp [V,J]
  · dsimp [V,w]
    field_simp [hk]
    ring

/-- After common rescaling, eight remaining anchor entries are generated by
seven of them. The scaling factor is also nonzero in the all-zero case. -/
theorem seven_generators {F K : Type*} [Field F] [Field K] [Algebra F K] (b : Fin 8 → K) :
    ∃ (c : K) (y : Fin 7 → K), c ≠ 0 ∧ ∀ j, c*b j ∈ IntermediateField.adjoin F (range y) := by
  classical
  by_cases nonzero : ∃ j, b j ≠ 0
  · obtain ⟨j,hj⟩ := nonzero
    let y (k : Fin 7) := (b j)⁻¹*b (j.succAbove k)
    refine ⟨(b j)⁻¹,y,inv_ne_zero hj,fun m => ?_⟩
    by_cases h : m = j
    · subst m
      simp [hj]
    · obtain ⟨k,rfl⟩ := Fin.exists_succAbove_eq h
      exact IntermediateField.subset_adjoin F _ ⟨k,rfl⟩
  · push Not at nonzero
    exact ⟨1,fun _ => 0,one_ne_zero,fun j => by simp [nonzero]⟩

/-- One nonzero common scaling gives another compatible tangent, brings
all right-hand data into a seven-generated field, and leaves an original
abscissa transcendental over its relative algebraic closure. -/
theorem normalize_four_anchors {F K : Type*} [Field F] [Field K] [Algebra F K]
    {p : Fin 8 → Fin 2 → K} {r : Fin 4 → Fin 2 → K} {R H U A a}
    (eqs : Compatible p r R H U A a) (hr : r 1 ≠ r 0) {x : Fin 8 → K}
    (hx : AlgebraicIndependent F x) :
    ∃ y : Fin 7 → K, ∃ H' U' A' a', Compatible p r R H' U' A' a' ∧
      (∀ j h, U' j h ∈ IntermediateField.adjoin F (range y)) ∧
      (∀ j, a' j ∈ IntermediateField.adjoin F (range y)) ∧
      ∃ i, Transcendental (algebraicClosure (IntermediateField.adjoin F (range y)) K) (x i) := by
  classical
  obtain ⟨V,T,B,b,k,he,h0,hb,h1⟩ := remove_rigid_motion eqs hr
  let other : Fin 2 := if k=0 then 1 else 0
  let entries : Fin 8 → K := ![T 1 other,T 2 0,T 2 1,T 3 0,T 3 1,b 1,b 2,b 3]
  obtain ⟨c,y,hc,hmem⟩ := seven_generators (F := F) entries
  refine ⟨y,(fun i h => c*V i h),(fun j h => c*T j h),(fun i => c*B i),
    (fun j => c*b j),?_,?_,?_,eight_against_seven x y hx⟩
  · intro i j
    obtain ⟨h,h'⟩ := he i j
    constructor
    · linear_combination c*h
    · exact fun h => h' (mul_left_cancel₀ hc h)
  · intro j h
    have g0 := hmem 0
    have g1 := hmem 1
    have g2 := hmem 2
    have g3 := hmem 3
    have g4 := hmem 4
    fin_cases k <;> fin_cases j <;> fin_cases h <;>
      simp_all [entries,other]
  · intro j
    have g5 := hmem 5
    have g6 := hmem 6
    have g7 := hmem 7
    fin_cases j <;> simp_all [entries]

end
end PlanarUnitDistances.GenericParameters
