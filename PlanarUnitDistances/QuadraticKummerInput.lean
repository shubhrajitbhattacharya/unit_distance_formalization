import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Tactic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Algebra.Group.Int.TypeTags

/-! The quadratic specialization of Kummer duality and its use after the
generic radicands have been shown to have private simple zeros.
J. S. Milne, Fields and Galois Theory, Theorem 5.30 and Remark 5.32, for n = 2.
The field extension in the premise is generated by the four actual roots. -/
namespace PlanarUnitDistances.FourRowObstruction
open Finset
noncomputable section

/-- Integer orders restricted to the multiplicative group of the coefficient
field. Their values need only distinguish the four chosen radicands. -/
def PrivateOrders {K : Type*} [Field K] (D : Fin 4 → Kˣ) : Prop :=
  ∀ i, ∃ w : Kˣ →* Multiplicative ℤ, (w (D i)).toAdd=1 ∧
    ∀ j, j≠i → (w (D j)).toAdd=0

def IndependentClasses {K : Type*} [Field K] (D : Fin 4 → Kˣ) : Prop :=
  ∀ s : Finset (Fin 4), s.Nonempty → ∀ u : Kˣ, (∏ j∈s,D j)≠u^2

/-- A selected private order is 1 on the product and even on a square. -/
theorem independent_of_private_orders {K : Type*} [Field K] {D : Fin 4 → Kˣ}
    (orders : PrivateOrders D) : IndependentClasses D := by
  intro T ht u e
  obtain ⟨i,hi⟩ := ht
  obtain ⟨w,wi,wj⟩ := orders i
  have value : w (∏ j∈T,D j)=w (D i) := by
    rw [map_prod]
    apply Finset.prod_eq_single i
    · intro k _ hki
      have h := wj k hki
      exact congrArg Multiplicative.ofAdd h
    · exact fun hn => (hn hi).elim
  have q := congrArg (fun z : Kˣ => (w z).toAdd) e
  change (w (∏ j∈T,D j)).toAdd=(w (u^2)).toAdd at q
  rw [value,wi,map_pow,Int.toAdd_pow] at q
  omega


end
end PlanarUnitDistances.FourRowObstruction
